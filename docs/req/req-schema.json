{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Felix-Free/AI-Finance-Assistant/docs/req/req-schema.json",
  "title": "AI Finance Assistant Requirements Schema",
  "description": "JSON Schema (Draft 2020-12) for requirements.yaml once parsed to JSON. It validates structure, required fields, id patterns and status enums. ID uniqueness across arrays is NOT expressible in JSON Schema and is checked by the validation script.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_metadata",
    "scope",
    "functional_requirements",
    "nonfunctional_requirements",
    "invariants",
    "data_requirements",
    "ai_requirements",
    "error_handling_requirements",
    "security_requirements",
    "acceptance_criteria",
    "traceability",
    "pending_decisions"
  ],
  "properties": {
    "project_metadata": { "$ref": "#/$defs/project_metadata" },
    "scope": { "$ref": "#/$defs/scope" },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/functional_requirement" }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonfunctional_requirement" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "data_requirements": { "$ref": "#/$defs/data_requirements" },
    "ai_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ai_requirement" }
    },
    "error_handling_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/error_requirement" }
    },
    "security_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/security_requirement" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptance_criterion" }
    },
    "traceability": { "$ref": "#/$defs/traceability" },
    "pending_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/pending_decision" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["approved", "pending_confirmation", "rejected", "deferred"]
    },
    "priority": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "project_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "phase", "role_owner", "repository", "default_branch", "model", "sources"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "phase": { "type": "integer" },
        "role_owner": { "type": "string" },
        "repository": { "type": "string" },
        "default_branch": { "type": "string" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "configured_via", "env_var", "note"],
          "properties": {
            "id": { "type": "string" },
            "configured_via": { "type": "string" },
            "env_var": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "in_scope", "non_goals"],
      "properties": {
        "summary": { "type": "string" },
        "in_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "non_goals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "out_of_current_scope_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "functional_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "input", "output", "preconditions",
        "expected_behavior", "acceptance_criteria", "verification_method", "priority", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^FR-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "preconditions": { "type": "string" },
        "expected_behavior": { "type": "string" },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification_method": { "type": "string" },
        "priority": { "$ref": "#/$defs/priority" },
        "status": { "$ref": "#/$defs/status" },
        "notes": { "type": "string" }
      }
    },
    "nonfunctional_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "metric", "threshold", "verification", "priority", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^NFR-\\d{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "threshold": {
          "description": "Numeric threshold, or null when not yet approved (must then have status pending_confirmation).",
          "type": ["number", "integer", "null"]
        },
        "verification": { "type": "string", "minLength": 1 },
        "priority": { "$ref": "#/$defs/priority" },
        "status": { "$ref": "#/$defs/status" },
        "owner": { "type": "string" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "threshold": { "type": "null" } }, "required": ["threshold"] },
          "then": {
            "properties": { "status": { "const": "pending_confirmation" } },
            "required": ["owner"]
          }
        }
      ]
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ref", "rule", "enforcement", "owner_spec", "owner_impl", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^(C-INV|INV)-\\d{3}$|^C-INV-PENDING-\\d{2}$" },
        "source_ref": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "enforcement": { "type": "string" },
        "owner_spec": { "type": "string" },
        "owner_impl": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "notes": { "type": "string" }
      }
    },
    "data_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "fields", "storage_status"],
      "properties": {
        "layers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "layer", "type", "required", "legal_values", "validation"],
            "properties": {
              "name": { "type": "string" },
              "layer": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "legal_values": { "type": "string" },
              "validation": { "type": "string" }
            }
          }
        },
        "excluded_fields_not_in_code": { "type": "string" },
        "storage_status": { "type": "string" }
      }
    },
    "ai_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^AI-REQ-\\d{3}$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "error_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_ref", "behavior", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^ERR-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "behavior": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "security_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^SEC-\\d{3}$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "scenario", "given", "when", "then", "verification", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-\\d{3}$" },
        "requirement": { "type": "string", "pattern": "^FR-\\d{3}$" },
        "scenario": { "type": "string", "enum": ["Normal", "Abnormal", "Boundary", "Negative", "Positive"] },
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "mappings"],
      "properties": {
        "note": { "type": "string" },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "invariant", "runtime_policy", "code", "tests"],
            "properties": {
              "requirement": { "type": "string", "pattern": "^FR-\\d{3}$" },
              "invariant": { "type": ["string", "null"] },
              "runtime_policy": { "type": ["string", "null"] },
              "code": { "type": "string" },
              "tests": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "pending_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "question", "status", "owner", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^PD-\\d{3}$" },
        "topic": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pending_confirmation"] },
        "owner": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
